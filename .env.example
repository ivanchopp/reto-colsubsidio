# Plantilla de credenciales — copia este archivo como ".env" y completa los valores reales.
# El archivo ".env" NUNCA debe compartirse, subirse a git ni pegarse en el chat.

# --- LLM (agente conversacional) ---
# Deja solo la variable del proveedor que vayas a usar.
LLM_PROVIDER=openai            # openai | gemini | vertex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Vertex AI (alternativa a GOOGLE_API_KEY: usa la cuenta de facturacion
# de Cloud directamente en vez del limite diario gratuito de AI Studio) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=vertex-credentials.json

# --- Envío de correo al asesor comercial (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ASESOR_EMAIL_DESTINO=

# --- Base de datos en la nube (Supabase/Postgres) ---
# Reemplaza los Excel locales de RECURSOS/. Cadena de conexion desde tu
# proyecto de Supabase: Project Settings > Database > Connection string
# (elige el formato "SQLAlchemy" / URI). Ejemplo:
# postgresql+psycopg://postgres:TU-PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
SUPABASE_DB_URL=

# --- Panel del asesor comercial (/asesor) ---
# Contrasena compartida (HTTP Basic Auth, usuario fijo "asesor") para
# entrar al dashboard de leads. Si se deja vacia, /asesor y /api/asesor/*
# quedan deshabilitados (falla cerrado, nunca abierto por accidente).
ASESOR_PASSWORD=
